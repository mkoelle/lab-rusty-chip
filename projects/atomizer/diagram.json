{
  "version": 1,
  "author": "Mark Koelle",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-led",
      "id": "power_led",
      "top": -90,
      "left": 200,
      "attrs": { "color": "blue", "label": "Board power" }
    },
    {
      "type": "wokwi-led",
      "id": "trigger_led",
      "top": -90,
      "left": 260,
      "attrs": { "color": "yellow", "label": "Trigger" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "mode_btn",
      "top": 140,
      "left": 200,
      "attrs": { "color": "green", "label": "Mode" }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "water_sw",
      "top": 60,
      "left": 220,
      "attrs": {}
    }
  ],
  "connections": [
    ["esp:TX", "$serialMonitor:RX", "", []],
    ["esp:RX", "$serialMonitor:TX", "", []],
    ["esp:26", "power_led:A", "blue", []],
    ["power_led:C", "esp:GND.2", "black", []],
    ["esp:27", "trigger_led:A", "gold", []],
    ["trigger_led:C", "esp:GND.2", "black", []],
    ["esp:19", "mode_btn:1.l", "green", []],
    ["mode_btn:2.l", "esp:GND.3", "black", []],
    ["esp:18", "water_sw:2", "orange", []],
    ["water_sw:1", "esp:GND.3", "black", []]
  ],
  "dependencies": {}
}
